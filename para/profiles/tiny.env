# Perfil tiny: una VM de 4 vCPU / 12 GB (~8.2 GB de límites; el resto para el
# sistema, Docker y la caché de disco). Para un piloto o una comunidad chica.
# vlpds necesita 2 GB propios: en una VM de 8 GB no queda margen.
#
# Son límites (techos), no consumo. Cualquier valor se sobrescribe en .env.
# Tabla completa y por qué de cada número: docs/CONFIGURACION.md.

# Postgres (una sola instancia para todo: para, matrix, mas, bridge)
POSTGRES_MEM=1g
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=4MB
PG_MAX_CONNECTIONS=100

# Redis es solo caché: sin disco, expulsa lo viejo al llenarse.
REDIS_MEM=128m
REDIS_MAXMEMORY=96mb

# vlpds (el PDS). Sus cachés se dimensionan con VLPDS_MEM: menos de 2 GB no
# le alcanza (vlpds --memory-plan). Un shard y un lease largo: un solo nodo no
# tiene a quién ceder sus shards, así que renovar menos ahorra peticiones al
# bucket. Tras una caída dura (OOM, SIGKILL) no escribe durante ~un lease.
VLPDS_MEM=2g
VLPDS_SHARDS=1
VLPDS_LEASE_TTL_MS=60000
VLPDS_SLATEDB_MANIFEST_POLL=60s
VLPDS_DISK_CACHE_MB=4096
VLPDS_FIREHOSE_RING_MB=64
VLPDS_FIREHOSE_MERGE_QUEUE_MB=32
VLPDS_FIREHOSE_MAX_LAG_MB=64
VLPDS_LIVE_RING_MB=32
VLPDS_BACKFILL_READAHEAD_MB=16
VLPDS_BACKFILL_CACHE_MB=32
VLPDS_FIREHOSE_MAX_BACKFILLS=4
VLPDS_MAX_EXPORTS=4
VLPDS_LAZY_MST_NODE_CACHE_MB=64
VLPDS_FIREHOSE_THREADS=1
RELAY_MEM=256m

# AppView (un solo dataplane: indexa el firehose)
BSKY_MEM=768m
BSKY_REPLICAS=1
DATAPLANE_MEM=512m
BSYNC_MEM=192m
OZONE_MEM=384m

# Matrix
SYNAPSE_MEM=1g
SYNAPSE_CACHE_FACTOR=0.5
MAS_MEM=192m
PARA_IDP_MEM=96m
ELEMENT_MEM=64m
BRIDGE_MEM=384m

# Identidad
MUBEZ_MEM=512m
# Cada cambio de la base de mubEZ llega al bucket en este intervalo.
LITESTREAM_SYNC_INTERVAL=1s

# Edge y operación
WEB_MEM=128m
CADDY_MEM=128m
ALLOY_MEM=256m
BACKUP_MEM=256m
BACKUP_INTERVAL=6h
BACKUP_RETENTION=14d
