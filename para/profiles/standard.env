# Perfil standard: la máquina principal de producción, 8 vCPU / 32 GB / NVMe.
# Las AppViews (bsky + dataplane) corren en réplicas y pueden crecer a otras
# máquinas (APPVIEW_WORKERS, docs/ESCALADO.md).
#
# Son límites (techos), no consumo. Cualquier valor se sobrescribe en .env.

POSTGRES_MEM=8g
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_WORK_MEM=16MB
PG_MAX_CONNECTIONS=300

REDIS_MEM=1g
REDIS_MAXMEMORY=768mb

PDS_MEM=2g
BSKY_MEM=2g
BSKY_REPLICAS=2
DATAPLANE_MEM=2g
DATAPLANE_REPLICAS=2
BSYNC_MEM=512m
OZONE_MEM=1g

SYNAPSE_MEM=4g
SYNAPSE_CACHE_FACTOR=2.0
MAS_MEM=512m
PARA_IDP_MEM=128m
ELEMENT_MEM=128m
BRIDGE_MEM=1g

MUBEZ_MEM=1g
LITESTREAM_SYNC_INTERVAL=1s

WEB_MEM=256m
CADDY_MEM=512m
ALLOY_MEM=512m
BACKUP_MEM=1g
BACKUP_INTERVAL=1h
BACKUP_RETENTION=30d
