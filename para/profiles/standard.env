# Perfil standard: la máquina principal de producción, 8 vCPU / 32 GB / NVMe.
# El AppView (bsky) corre en réplicas y puede crecer a otras máquinas
# (APPVIEW_WORKERS, docs/ESCALADO.md); el dataplane que indexa es uno.
#
# Son límites (techos), no consumo. Cualquier valor se sobrescribe en .env.

POSTGRES_MEM=6g
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_WORK_MEM=16MB
PG_MAX_CONNECTIONS=300

REDIS_MEM=1g
REDIS_MAXMEMORY=768mb

# vlpds (el PDS): los valores de producción de vlpds (6–8 núcleos, NVMe).
# 64 shards y un lease corto dejan que un segundo nodo tome los shards de
# uno caído en segundos (docs/ESCALADO.md).
VLPDS_MEM=6g
VLPDS_SHARDS=64
VLPDS_LEASE_TTL_MS=10000
VLPDS_SLATEDB_MANIFEST_POLL=10s
VLPDS_DISK_CACHE_MB=65536
VLPDS_FIREHOSE_RING_MB=512
VLPDS_FIREHOSE_MERGE_QUEUE_MB=256
VLPDS_FIREHOSE_MAX_LAG_MB=128
VLPDS_LIVE_RING_MB=128
VLPDS_BACKFILL_READAHEAD_MB=64
VLPDS_BACKFILL_CACHE_MB=256
VLPDS_FIREHOSE_MAX_BACKFILLS=16
VLPDS_MAX_EXPORTS=32
VLPDS_LAZY_MST_NODE_CACHE_MB=256
VLPDS_FIREHOSE_THREADS=4
RELAY_MEM=1g

# AppView: réplicas de bsky; un solo dataplane (indexa el firehose).
BSKY_MEM=2g
BSKY_REPLICAS=2
DATAPLANE_MEM=2g
BSYNC_MEM=512m
OZONE_MEM=1g

SYNAPSE_MEM=4g
SYNAPSE_CACHE_FACTOR=2.0
MAS_MEM=512m
PARA_IDP_MEM=128m
ELEMENT_MEM=128m
BRIDGE_MEM=1g

MUBEZ_MEM=1g
LITESTREAM_SYNC_INTERVAL=1s

WEB_MEM=256m
CADDY_MEM=512m
ALLOY_MEM=512m
BACKUP_MEM=1g
BACKUP_INTERVAL=1h
BACKUP_RETENTION=30d
