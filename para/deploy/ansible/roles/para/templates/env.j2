# {{ ansible_managed }}
# Generado por el rol para; los cambios se hacen en el inventario.
{% for key, value in para_env | dictsort %}
{{ key }}={{ value }}
{% endfor %}
PARA_ROLE={{ para_role }}
PARA_SECRETS_GID={{ para_secrets_gid }}
{% if para_private_ip is defined %}
PARA_PRIVATE_BIND={{ para_private_ip }}
{% endif %}
{% if para_role == 'appview-worker' %}
PARA_PRIMARY_IP={{ para_primary_ip }}
{% elif groups['para_appview'] | default([]) | length > 0 %}
APPVIEW_WORKERS={% for h in groups['para_appview'] %}{{ hostvars[h].para_private_ip }}:2584{{ ' ' if not loop.last else '' }}{% endfor %}

{% endif %}
WATZAPPA_DIR={{ para_root }}/WatZappa
MUBEZ_DIR={{ para_root }}/mubEZ
