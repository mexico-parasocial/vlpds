 #[expect(clippy::unwrap_used)]
 pub static DB: LazyLock<Keyspace> = LazyLock::new(|| open_keyspace(&db_path()).unwrap());
+// Only events below this watermark may reach subscribers. An acknowledged
+// downstream cursor must survive SIGKILL without being reused for another event.
+pub static DURABLE_CURSOR: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+pub fn replay_head(db: &Keyspace, firehose: &fjall::PartitionHandle) -> fjall::Result<Cursor> {
+    let metadata = db.open_partition("metadata", PartitionCreateOptions::default())?;
+    let saved = metadata.get("head")?.map(Cursor::from).unwrap_or_default();
+    let tail = firehose.last_key_value()?.map(|(key, _)| Cursor::from(key)).unwrap_or_default();
+    Ok(Cursor::from(saved.get().max(tail.get())))
+}
+
+pub fn save_replay_head(db: &Keyspace, cursor: Cursor) -> fjall::Result<()> {
+    let metadata = db.open_partition("metadata", PartitionCreateOptions::default())?;
+    metadata.insert("head", cursor.as_ref())
+}
+
+pub fn upstream_checkpoint(db: &Keyspace, host: &str) -> fjall::Result<Option<(Cursor, i64)>> {
+    let metadata = db.open_partition("metadata", PartitionCreateOptions::default())?;
+    let Some(value) = metadata.get(format!("upstream/{host}"))? else { return Ok(None) };
+    let Ok(bytes) = <[u8; 16]>::try_from(value.as_ref()) else { return Ok(None) };
+    let mut cursor = [0; 8];
+    let mut time = [0; 8];
+    cursor.copy_from_slice(&bytes[..8]);
+    time.copy_from_slice(&bytes[8..]);
+    Ok(Some((Cursor::from(u64::from_be_bytes(cursor)), i64::from_be_bytes(time))))
+}
+
+pub fn save_upstream_checkpoint(
+    db: &Keyspace, host: &str, cursor: Cursor, time: i64,
+) -> fjall::Result<()> {
+    let metadata = db.open_partition("metadata", PartitionCreateOptions::default())?;
+    let mut bytes = [0; 16];
+    bytes[..8].copy_from_slice(cursor.as_ref());
+    bytes[8..].copy_from_slice(&time.to_be_bytes());
+    metadata.insert(format!("upstream/{host}"), bytes)
