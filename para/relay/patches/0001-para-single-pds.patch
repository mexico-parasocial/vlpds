+fn upstream_url(
+    hostname: &str, path: &str, configured_host: Option<&str>, configured_url: Option<&str>,
+) -> Result<Url, Box<tungstenite::Error>> {
+    let invalid = || {
+        Box::new(tungstenite::Error::Io(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid or untrusted relay upstream",
+        )))
+    };
+    if configured_host.is_some_and(|host| hostname != host) {
+        return Err(invalid());
+    }
+    let mut url =
+        Url::parse(&configured_url.map_or_else(|| format!("https://{hostname}"), str::to_owned))
+            .map_err(|_| invalid())?;
+    if url.host_str().is_none()
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || url.query().is_some()
+        || url.fragment().is_some()
+        || url.path() != "/"
+    {
+        return Err(invalid());
+    }
+    let scheme = match url.scheme() {
+        "http" => "ws",
+        "https" => "wss",
+        _ => return Err(invalid()),
+    };
+    url.set_scheme(scheme).map_err(|()| invalid())?;
+    url.set_path(&format!("/xrpc/{path}"));
+    Ok(url)
+}
+
+#[cfg(test)]
+mod para_tests {
+    use super::*;
+
+    #[test]
+    fn private_transport_keeps_public_identity_and_rejects_other_hosts() {
+        let url = upstream_url(
+            "pds.example.org",
+            "com.atproto.sync.subscribeRepos",
+            Some("pds.example.org"),
+            Some("http://pds:2583"),
+        )
+        .unwrap();
+        assert_eq!(url.as_str(), "ws://pds:2583/xrpc/com.atproto.sync.subscribeRepos");
+        assert!(
+            upstream_url(
+                "attacker.example",
+                "anything",
+                Some("pds.example.org"),
+                Some("http://pds:2583")
+            )
+            .is_err()
+        );
+        for bad in [
+            "ftp://pds:2583",
+            "http://user:password@pds:2583",
+            "http://pds:2583?cursor=7",
+            "http://pds:2583/other",
+        ] {
+            assert!(
+                upstream_url("pds.example.org", "anything", Some("pds.example.org"), Some(bad))
+                    .is_err()
+            );
+        }
+    }
+}
