# Configuración NO secreta de mubEZ (broker M8). Copia a env/identity.env si
# necesitas cambiar algo; todo es opcional. Los secretos son archivos de
# secrets/ (make secrets): si uno aparece aquí también, mubEZ no arranca.
#
# Ya los fija la plataforma (overrides/identity.yaml) a partir de .env:
# NODE_ENV=production, SERVICE_URL, PDS_URL, PLC_URL, CORS_ORIGIN
# (M8_CORS_ORIGIN), OAUTH_RETURN_TO_ALLOWLIST (M8_OAUTH_RETURN_TO_ALLOWLIST)
# y GROWTHBOOK_FEATURE_OVERRIDES (handoff OAuth sí, dev-token bootstrap no).

# Emisor de credenciales de identidad. La llave privada y la pública son
# secrets/m8_issuer_private_jwk y secrets/m8_issuer_public_jwk.
IDENTITY_ISSUER_DID=did:m8:ine:emisor-001
IDENTITY_ISSUER_KEY_ID=ine-ed25519-2026-01

CURP_PEPPER_KEY_ID=v1
LOG_LEVEL=info

# Límites de peticiones (por IP real; Caddy pasa X-Forwarded-For).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100
# RATE_LIMIT_AUTH_MAX=20
